# AWS Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# AWS Region
AWS_REGION=ap-south-1

# DynamoDB Table Names
ASSESSMENTS_TABLE=HeatCreditAssessments
RECOMMENDATIONS_TABLE=HeatCreditRecommendations
BUILDINGS_TABLE=HeatCreditBuildings

# API Gateway URL (set after deployment)
NEXT_PUBLIC_API_URL=https://YOUR_API_GATEWAY_ID.execute-api.ap-south-1.amazonaws.com/prod

# Open-Meteo (no API key required for non-commercial use)
# Attribution: https://open-meteo.com — CC BY 4.0
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Demo mode flag (set to "true" to force fallback data in demos)
DEMO_MODE=false
