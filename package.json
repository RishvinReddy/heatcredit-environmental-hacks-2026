{
  "name": "heatcredit",
  "version": "1.0.0",
  "description": "Heat Resilience Decision Engine — HeatCredit hackathon project",
  "private": true,
  "scripts": {
    "test:scoring": "npx ts-node --project tsconfig.test.json tests/scoring/scoring.test.ts",
    "test:optimizer": "npx ts-node --project tsconfig.test.json tests/optimizer/optimizer.test.ts",
    "test:weather": "npx ts-node --project tsconfig.test.json tests/weather/weather.test.ts",
    "test:warnings": "npx ts-node --project tsconfig.test.json tests/warnings/warnings.test.ts",
    "test:evidence": "npx ts-node --project tsconfig.test.json tests/evidence/evidence.test.ts",
    "test:validation": "npx ts-node --project tsconfig.test.json tests/validation/validation.test.ts",
    "test": "npm run test:scoring && npm run test:optimizer && npm run test:weather && npm run test:warnings && npm run test:evidence && npm run test:validation",
    "test:api:local": "bash tests/api/test-api.sh http://localhost:3001",
    "test:api:deployed": "bash tests/api/test-api.sh",
    "build": "sam build",
    "deploy": "sam deploy",
    "deploy:guided": "sam deploy --guided",
    "local:api": "sam local start-api --port 3001",
    "invoke:health": "sam local invoke HealthFunction --event events/health.json",
    "invoke:assessment": "sam local invoke AssessmentFunction --event events/assessment-school.json",
    "invoke:optimize": "sam local invoke OptimizationFunction --event events/optimize.json",
    "dev:web": "cd apps/web && npm run dev",
    "logs:assessment": "sam logs --name AssessmentFunction --stack-name heatcredit-prod --tail",
    "logs:optimization": "sam logs --name OptimizationFunction --stack-name heatcredit-prod --tail"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  }
}
