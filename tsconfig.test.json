{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "tests/**/*",
    "backend/**/*",
    "data/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps"
  ]
}
